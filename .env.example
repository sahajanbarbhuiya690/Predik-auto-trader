PORT=3000
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Real SMS OTP (optional until you configure Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Predik: keep this ONLY on the server
PREDIK_API_KEY=
# Optional default market ID; dashboard can override it
PREDIK_MARKET_ID=
# INR conversion used for the INR input. Set a fresh rate before live trading.
USD_INR_RATE=90
# Safety: maximum INR per order
MAX_INR_ORDER=2000
# Set false until you have tested everything.
LIVE_TRADING=false
